# The TNG mod, declared instead of installed.
#
# 51 Star Trek hulls across seven factions, with their own keys. Nothing here collides with
# `data/shipData.yaml`, so this ADDS ships rather than replacing them - a mission can spawn
# a Saber and a Light Cruiser in the same map, and a second Trek mod can be installed
# alongside this one.
#
# That is a deliberate departure from the zip this came from, which is a re-skin: it
# repoints 50 keys the game already owns, so installing it turns every light cruiser in
# every mission into a Saber. The re-skin does work - measured on engine 1.3.5 by
# missions/shipdata_override, an add-on entry beats the engine's own shipData for the same
# key - but it makes the mod a conversion rather than content. The zip's author wants this
# too: "I'll eventually create a TNG mission suite that breaks away from this."
#
# Nothing in `f:\a\Cosmos-1-3-0\data\` is touched. See README.md for what installing the
# original zip costs, and for the parts of the mod that still cannot declare.
provides tng_races

import tng_setup.py
import tng_media.mast
import tng_face_builder.mast
import tng_ordnance.py
import tng_stations.py
import tng_torpedoes.mast


# ---- Factions ------------------------------------------------------
#
# ADDS the TNG factions to PLAYABLE_RACES / NPC_RACES rather than replacing them, so
# Klingons can raid a TSN crew and a Galaxy can fight Kraliens. A pure TNG game is then a
# mission SETTING - name only these factions - rather than something a mastlib does to you.
#
# First, because every gate below reads those settings.
tng_registered = tng_register_races()
log("tng_races: factions added -> " + ", ".join(tng_registered), "tng_races")


# ---- Soundtrack ----------------------------------------------------
#
# Same stance as the factions above: this is a DEFAULT, not a takeover.
# `settings_set_mod_default` loses to anything the mission's settings.yaml, a profile, or
# the operator's dropdown actually says - so a mission that wants stock music simply says
# so, and one that says nothing gets the mod's. The bank itself is declared in
# tng_media.mast; see there for why it may still play `default` on engine 1.3.6.
tng_music_applied = tng_set_default_music()
log("tng_races: soundtrack -> " + tng_music_applied, "tng_races")


# ---- Theaters ------------------------------------------------------
#
# WHO a mission fights, as data. A theater rosters races in the MISSION'S vocabulary and an
# `Art:` map says how those races are drawn - LM branches on the race NAME to pick an enemy
# station type, so a roster of Trek faction names would make those branches fall through and
# spawn no stations at all.
#
# Declaring them costs nothing: a theater only takes effect when THEATER names it, and with
# THEATER unset every consumer keeps its own literal list. So this is safe to load
# unconditionally, and a mission that has never heard of theaters is unaffected.
#
# media_read_relative_file, not theater_load_amd: it reads from the addon folder OR from
# inside the packaged .mastlib, and get_mission_dir_filename cannot reach into a zip.
tng_theaters = theater_declare_text(media_read_relative_file("theaters.amd"))
log("tng_races: theaters -> " + ", ".join(sorted(tng_theaters)), "tng_races")


# ---- Version -------------------------------------------------------
#
# Logged and published as a shared variable, so a running game can say which build of the
# mod it has - and so the test range can catch a HALF-UPDATED install, where the mastlib is
# one version and the media pack another. Both halves are stamped by _build_from_zip.py from
# __lib__.json, which is the single place to bump.
tng_manifest = load_json_string(media_read_relative_file("tng_manifest.json"))
tng_version = tng_manifest.get("version")
set_shared_variable("TNG_MOD_VERSION", tng_version)
log("tng_races: " + tng_manifest.get("mod") + " " + tng_version, "tng_races")


# ---- Ships ---------------------------------------------------------
#
# Unconditional. The gates below decide whose INTERIORS and FLEETS load; the hulls
# themselves should always be spawnable, or a mission cannot place a single Galor without
# turning the whole Cardassian race on.
#
# The ship list lives in the MEDIA PACK, not in this mastlib, because the ENGINE opens it
# itself and a mastlib is a zip - which is why a mission has to declare the pack in
# `shared_media` alongside this mastlib. `tng_declare_ships` finds it through
# `ship_data_add_extra`, which searches the mission and then each pinned pack and PREFERS
# the unpacked `__lib__/media` copy: the only one the engine can open.
#
# THE JSON IS THE ARTIFACT and the name here carries no extension. The engine reads these
# files as HJSON, not YAML, and when a .yaml sits beside a .json it opens the .yaml and
# rejects it whole - so the pack ships exactly one file. Carrying both also put 119KB of
# unreadable duplicate in every install and made "which one is stale" a silent failure.
# BREADCRUMB, and it earns its place. When the hulls do not arrive there is exactly one
# line in debug.log to go on - the one ship_data_add_extra writes - and its ABSENCE is
# ambiguous: it means either that this file never executed at all, or that it did and
# never reached this section. Those need different fixes and looked identical for a whole
# session. One line before the call separates them for good.
#
# DEBUG, not print or log: debug.log is the only channel that survives an engine session.
tng_breadcrumb("tng_races: __init__.mast reached the Ships section")
tng_declared = tng_declare_ships()
# print, NOT log. log() is Python logging with no handler attached and is invisible in
# the engine - and this line is the ONLY report of whether the engine accepted the
# mod's ships at all, which is the first question asked whenever a hull does not
# appear. `debug.log` carries the detail - which file was found, what path the engine was
# handed, and whether it took it - written by ship_data_add_extra itself.
print("tng_races: " + str(len(ship_data_filter_ship_data_by_side("tng_", None) or [])) + " hulls, " + tng_declared)


# ---- Interiors and fleets ------------------------------------------
#
# Driven by tng_manifest.json rather than fifty literal calls, which would drift silently
# the first time a hull is renamed. The helpers ask the settings which factions are on.

for tng_plan in tng_interiors_enabled(tng_manifest):
    grid_merge_ascii(media_read_relative_file(tng_plan), "tng_races")

for tng_ladder in tng_fleets_enabled(tng_manifest):
    fleet_table_load_yaml(media_read_relative_file(tng_ladder), "tng_races")


# ---- Portraits -----------------------------------------------------
#
# 192 character portraits, keyed by name: `image://tng:picard`. They are IMAGES, not faces -
# `gui_face` needs 512px layers from a sheet listed in `data/graphics/allFaceFiles.txt`, and
# a mastlib cannot write that file. `ImageAtlas` resolves out of the unpacked media pack, so
# these ship with the mod and need nothing installed.
#
# The sheet is in the MEDIA PACK because the engine opens the .png itself; the name list is
# in this mastlib because only MAST reads it. Same split as the ship data above.
#
# 36 cells are identified people (picard, worf, quark, ...). The rest carry descriptive keys
# built from era and uniform division (`tng_ops_07`) rather than guessed names - a wrong
# name here would fail silently, because a bad atlas key just never matches.
tng_portrait_names = load_json_string(media_read_relative_file("tng_portraits.json"))
tng_portrait_sheet = media_shared("portraits/tng_portraits")
tng_portrait_status = tng_register_portraits(tng_portrait_sheet, tng_portrait_names)
log("tng_races: " + tng_portrait_status, "tng_races")


# ---- Crews ---------------------------------------------------------
#
# Who is at the console. `Hull:` inside the file binds each roster to its class, so a Galaxy
# arrives with Picard's staff and an Intrepid with Janeway's - the MOD tier of the crew
# resolution, which loses to a mission's own crew, to the operator's Crew dropdown, and to
# anything a player chose about themselves. An answer, never an imposition.
#
# `crew_declare_amd`, not `crew_load_amd`: the latter resolves MISSION-relative and an addon
# lives inside a zip. Same trap `sides_load_amd` has.
#
# Portraits rather than faces, for the reason the block below spells out - a portrait needs
# nothing installed, a face needs allFaceFiles.txt edited by hand.
tng_crew_rosters = crew_declare_amd(amd_document(media_read_relative_file("tng_crew.amd"), data_parser=amd_crew_data))
log("tng_races: " + str(len(tng_crew_rosters)) + " crew rosters", "tng_races")


# ---- Faces ---------------------------------------------------------
#
# The atlas sheets are a DIFFERENT mechanism from the portraits above. A portrait is a
# flat image out of an ImageAtlas (`image://tng:picard`); a face is composited by the
# engine from 512px cells of a sheet listed in `data/graphics/allFaceFiles.txt`, and can
# stack layers - which is what lets an implant overlay be drawn once and worn by anyone.
#
# `tng_faces.json` shipped in this mastlib from the first build and nothing read it, so
# `random_face("klingon")` was impossible. Registering it fixes that, and since engine
# 1.3.15 it also hands each sheet's art to the engine, out of the pinned media pack.
#
# Nothing needs pasting into allFaceFiles.txt (engine-verified 2026-10-14, stock file). An
# engine that cannot take a sheet (older than 1.3.15, or the first 1.3.15 exes, which only
# re-point a tag that file already names) still needs the lines `_tools/facesheets.py`
# prints. The status line logged below says how many it took. A
# sheet the engine does not have degrades to a face that does not draw, not to an error.
tng_face_map = load_json_string(media_read_relative_file("tng_faces.json"))
tng_face_index = load_json_string(media_read_relative_file("tng_face_index.json"))
tng_face_status = tng_register_faces(tng_face_map, tng_face_index)
log("tng_races: " + tng_face_status, "tng_races")


# ---- Taunts --------------------------------------------------------
#
# Trek taunts by Mike Substelny, keyed by faction - `race` IS `origin`, so a Galor looks up
# "cardassian". LM's own groups are left alone.
#
# THIS IS THE WEAKEST SEAM IN THE MOD. There is no registry for taunts the way there is for
# ship data, interiors and fleets, so this reaches for LM's `taunt_data` shared variable by
# name after its comms add-on has set it. Read through get_shared_variable, because a bare
# name for a variable no add-on defined is a NameError and "LegendaryMissions is not loaded"
# is a supported way to run. `.update()` so LM's groups survive. See README.
tng_taunt_data = load_json_string(media_read_relative_file("tng_taunts.json"))
tng_lm_taunts = get_shared_variable("taunt_data")

if tng_taunt_data is not None and tng_lm_taunts is not None:
    tng_lm_taunts.update(tng_taunt_data)
else:
    # Said out loud: the silent version is a game that quietly uses stock taunts forever.
    log("tng_races: taunt_data unavailable, TNG taunts NOT applied. Is this add-on listed "
        "after LegendaryMissions.comms in story.json?", "tng_races", "warning")


# ---- Diplomacy -----------------------------------------------------
#
# On the same route LM declares its own sides from, so the TNG sides exist before player
# ships and before any map runs. MUST NOT await - server_console relies on this route
# completing synchronously inside signal_emit.
#
# Not `once`: create_sides is re-run deliberately, because sim_create() leaves the sim
# handle stale for the rest of the frame and the sides have to be re-declared after it.
//shared/signal/create_sides
    tng_sides_doc = amd_document(media_read_relative_file("tng_sides.amd"), data_parser=amd_side_data)
    sides_declare_amd(tng_sides_doc)

    # DIPLOMACY COLOURS, which nothing else sets for a mission built on this mod.
    #
    # These are the GLOBAL relation colours the 2D map paints contacts with - separate from
    # the per-faction `Color:` in tng_sides.amd, which is the side's own icon colour. LM sets
    # them in ITS create_sides route (maps/watch_for_end.mast), but that file is LM's own
    # mission content and is not in any mastlib - so a mission that loads the LM addons and
    # this mod, as the TNG suite does, declares eight factions and never sets a single
    # relation colour. Set here, on the route that already owns this mod's diplomacy.
    sim.set_diplomacy_color(sbs.DIPLOMACY.HOSTILE, "#F00")
    sim.set_diplomacy_color(sbs.DIPLOMACY.NEUTRAL, "#077")
    sim.set_diplomacy_color(sbs.DIPLOMACY.ALLIED, "#0F0")


# ART IS THE UNRESOLVED PART, and it is the only reason anyone would still be told to unzip
# over their game folder. The meshes travel in this mod's shared-media pack, but the engine
# resolves `artfileroot` relative to `data/graphics/ships`, so these hulls get their declared
# stats and the engine's `unknown` placeholder. See README.md - a 51-hull, seven-faction
# conversion now declares everything EXCEPT its art.
